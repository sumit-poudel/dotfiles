layout {

    focus-ring {
        active-color   "#b58fff"
        inactive-color "#000000"
        urgent-color   "#ff6f9b"
    }

    border {
        active-color   "#b58fff"
        inactive-color "#000000"
        urgent-color   "#ff6f9b"
    }


    tab-indicator {
        active-color   "#b58fff"
        inactive-color "#362a4c"
        urgent-color   "#ff6f9b"
    }

    insert-hint {
        color "#b58fff80"
    }
}

recent-windows {
    highlight {
        active-color "#b58fff"
        urgent-color "#ff6f9b"
    }
}
