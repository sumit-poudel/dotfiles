{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/art.txt",
    "type": "file",
    "padding": {
      "top": 1,
      "left": 0,
      "right": 0,
    },
  },
  "display": {
    "separator": "",
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "32", // = color2
        "at": "37",
        "host": "32",
      },
    },
    "break",
    {
      "type": "os",
      "key": "distro    ",
      "keyColor": "33",
    },
    {
      "type": "kernel",
      "format": "{release}",
      "key": "kernel    ",
      "keyColor": "33",
    },
    {
      "type": "packages",
      "format": "{pacman} (pacman)",
      "key": "packages  ",
      "keyColor": "33",
    },
    {
      "type": "shell",
      "key": "shell     ",
      "keyColor": "33",
    },
    {
      "type": "terminal",
      "key": "terminal  ",
      "keyColor": "33",
    },
    {
      "type": "wm",
      "format": "{} ({3})",
      "key": "wm        ",
      "keyColor": "33",
    },
    {
      "type": "battery",
      "format": "{capacity-bar}{capacity}",
      "percent": { "type": 3, "green": 30, "yellow": 15 },
      "key": "bat       ",
      "keyColor": "33",
    },
    {
      "type": "uptime",
      "format": "{formatted}",
      "key": "uptime    ",
      "keyColor": "33",
    },
    "break",
    {
      "type": "colors",
      "symbol": "diamond",
    },
    "break",
  ],
}
