{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/art.txt",
    "type": "file",
    "padding": {
      "top": 2,
      "left": 4,
      "right": 0,
    },
  },
  "display": {
    "separator": "  ",
  },
  "modules": [
    "break",
    {
      "type": "Title",
      "key": "user",
      "format": "{user-name>20}",
      "keyColor": "34",
      "outputColor": "34",
    },
    {
      "type": "Terminal",
      "key": "shell",
      "format": "{pretty-name>19}",
      "keyColor": "34",
      "outputColor": "34",
    },
    {
      "type": "WM",
      "key": "WM",
      "format": "{pretty-name>22}",
      "keyColor": "34",
      "outputColor": "34",
    },
    {
      "type": "OS",
      "key": "OS",
      "format": "{pretty-name>22}",
      "keyColor": "34",
      "outputColor": "34",
    },
    {
      "type": "Memory",
      "key": "memory",
      "format": "{used} {total}",
      "keyColor": "34",
      "outputColor": "34",
    },
    {
      "type": "Uptime",
      "key": "uptime",
      "keyColor": "34",
      "outputColor": "34",
      "format": "{formatted>18}",
    },
  ],
}
