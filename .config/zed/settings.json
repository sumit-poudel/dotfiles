{
  "icon_theme": "Material Icon Theme",
  "buffer_font_family": "Ioskeley Mono",
  "ui_font_family": "Ioskeley Mono",
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Everforest Material Dark",
  },
  "theme_overrides": {
    "Zedbox Material Hard Dark": {
      "border": "#1D2021",
    },
  },
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "buffer_line_height": "standard",
  "cursor_shape": "bar",
  "cursor_blink": false,
  "tab_size": 2,
  "auto_indent": "syntax_aware",
  "soft_wrap": "editor_width",
  "extend_comment_on_newline": false,
  "use_smartcase_search": true,
  "selection_highlight": false,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "show_edit_predictions": true,
  "code_lens": "on",
  "vertical_scroll_margin": 2,
  "horizontal_scroll_margin": 2,
  "autoscroll_on_clicks": true,
  "restore_on_startup": "empty_tab",
  "restore_on_file_reopen": false,
  "remove_trailing_whitespace_on_save": true,
  "hover_popover_enabled": false,
  "cli_default_open_behavior": "existing_window",
  "when_closing_with_no_tabs": "keep_window_open",
  "format_on_save": "off",
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
  },
  "title_bar": {
    "button_layout": "platform_default",
    "show_onboarding_banner": false,
    "show_branch_name": false,
    "show_sign_in": false,
    "show_user_picture": false,
    "show_worktree_name": false,
    "show_user_menu": false,
    "show_project_items": false,
  },
  "tab_bar": {
    "show": false,
  },
  "tabs": {
    "file_icons": true,
  },
  "toolbar": {
    "code_actions": false,
    "selections_menu": true,
    "quick_actions": false,
    "breadcrumbs": true,
  },
  "status_bar": {
    "active_encoding_button": "enabled",
  },
  "search": {
    "center_on_match": true,
    "regex": true,
  },
  "file_finder": {
    "modal_max_width": "full",
    "file_icons": true,
  },
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "vim_mode": true,
  "relative_line_numbers": "enabled",
  "vim": {
    "toggle_relative_line_numbers": true,
  },
  "terminal": {
    "font_family": "Ioskeley Mono Term",
    "dock": "right",
    "shell": {
      "with_arguments": {
        "program": "/bin/fish",
        "args": ["-c", "tmux new-session -A -s \"$(basename \"$PWD\")\""],
      },
    },
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "bracketSpacing": true,
    "jsxBracketSameLine": false,
    "arrowParens": "avoid",
    "proseWrap": "preserve",
    "endOfLine": "lf",
    "plugins": ["prettier-plugin-go-template"],
  },

  "languages": {
    "HTML": {
      "formatter": {
        "external": {
          "command": "prettier",
          "arguments": ["--stdin-filepath", "{buffer_path}"],
        },
      },
    },
    "TypeScript": {
      "show_edit_predictions": true,
    },
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always",
          },
        },
      },
      "enable_lsp_tasks": true,
    },
  },
  "edit_predictions": {
    "mode": "subtle",
    "provider": "copilot",
    "open_ai_compatible_api": {
      "api_url": "http://localhost:8080/v1/completions",
      "model": "bocalan/Qwen2.5-Coder-3B-Instruct-Q4_K_M-GGUF",
      "prompt_format": "qwen",
      "max_output_tokens": 64,
    },
  },
  "agent": {
    "default_model": {
      "provider": "lmstudio",
      "model": "deepseek-r1-distill-qwen-1.5b",
      "enable_thinking": false,
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "language_models": {
    "openai": {
      "api_url": "http://127.0.0.1:1234/v1",
      "available_models": [
        {
          "name": "qwen2.5-coder-1.5b-go-fim:Q8_0",
          "max_tokens": 16384,
        },
      ],
    },
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": "",
      },
    },
  },
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry",
    },
    "devin": {
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "model": "opencode/deepseek-v4.1-flash-free",
      },
      "type": "registry",
    },
  },
}
