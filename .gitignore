*.webm

# Files copied in by fisher. fish_plugins stays tracked so plugins can be reinstalled.
.config/fish/completions/*
.config/fish/conf.d/*
.config/fish/functions/*
.config/fish/themes/*
.config/fish/fish_variables

!.config/fish/conf.d/flipper.fish
!.config/fish/functions/fish_greeting.fish
!.config/fish/functions/history_keybinds.fish
!.config/fish/functions/x.fish

# MPD runtime. mpd.conf stays tracked.
.config/mpd/database
.config/mpd/log
.config/mpd/pid
.config/mpd/state
.config/mpd/sticker.sql

# Themes Noctalia writes. Hand-written configs that include them stay tracked.
.config/alacritty/themes/noctalia.toml
.config/bat/themes/noctalia.tmTheme
.config/btop/themes/noctalia.theme
.config/cava/themes/noctalia
.config/doom/themes/noctalia-theme.el
